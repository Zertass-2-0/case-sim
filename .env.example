# Copy this file to .env and replace every CHANGE_ME with your own value.
DB_USER=casesim
DB_PASSWORD=CHANGE_ME
DB_NAME=casesim

# Long random string used to sign login tokens (e.g. output of: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME

APP_PORT=3000

# Admin account, created automatically on first start
ADMIN_NICK=admin
ADMIN_PASSWORD=CHANGE_ME

STARTING_BALANCE=1000